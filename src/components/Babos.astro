---
import babos from '../data/babos.json';
---

<section id="babos" class="py-20 lg:py-28 bg-surface-dark border-b border-surface-border relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Club Manifesto / Intro Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-bold uppercase tracking-wider mb-4">
        Der Club
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display mb-8">
        „Ein Radsportclub, so schön wie seine Mitglieder.“
      </h2>
      <div class="space-y-4 text-gray-300 text-base sm:text-lg leading-relaxed text-left sm:text-center max-w-2xl mx-auto">
        <p>
          Wir lieben gemeinsamen Radsport auf der Straße und über die Trassen des Reviers – ohne Allüren, ohne Verbissenheit, aber immer mit Kette rechts und Freude am Ballern.
        </p>
        <p class="text-gray-400 font-medium">
          Wir fahren schnell, weit und am Limit, aber nie alles gleichzeitig. Ernst ist woanders: Bei uns wird Rad gefahren, gelacht und nach dem Ride entspannt ein Kaltgetränk gezischt.
        </p>
      </div>
    </div>

    <!-- Vorstand Sub-Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 pt-8 border-t border-surface-border/50">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-card border border-surface-border text-gray-400 text-xs font-semibold uppercase tracking-wider mb-3">
        Vorstand & Führung
      </div>
      <h3 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight font-display">
        Unsere Club-Babos
      </h3>
      <p class="text-gray-400 mt-2 text-sm sm:text-base">
        Die Köpfe hinter Dynamo Ruhr. Mit viel Watt in den Waden und noch mehr Quatsch im Kopf.
      </p>
    </div>

    <!-- Responsive 2-Columns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {babos.map((babo) => (
        <article class="group bg-surface-card rounded-3xl border border-surface-border p-6 sm:p-8 transition-all duration-300 hover:border-primary/50 hover:shadow-glow flex flex-col justify-between">
          <div>
            <!-- Top: Image & Header info -->
            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-6 text-center sm:text-left">
              
              <!-- Avatar Container with Orange Accent Ring -->
              <div class="relative w-28 h-28 sm:w-32 sm:h-32 shrink-0 rounded-2xl overflow-hidden border-2 border-primary/50 shadow-md group-hover:scale-105 transition-transform duration-300">
                <img 
                  src={babo.image} 
                  alt={`${babo.name} – ${babo.role} RC Dynamo Ruhr e.V.`} 
                  class="w-full h-full object-cover object-top"
                  loading="lazy"
                  width="256"
                  height="256"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-dark/60 via-transparent to-transparent"></div>
              </div>

              <!-- Name & Role -->
              <div class="flex-1">
                <span class="inline-block px-3 py-1 rounded-full bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-2">
                  {babo.role}
                </span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-white font-display">
                  {babo.name}
                </h3>
                <p class="text-primary font-medium text-sm italic mt-1 font-display">
                  „{babo.quote}“
                </p>
              </div>
            </div>

            <!-- Bio Description -->
            <p class="text-gray-300 text-sm sm:text-base leading-relaxed border-t border-surface-border/60 pt-4">
              {babo.bio}
            </p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
