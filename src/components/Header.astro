---
import club from '../data/club.json';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const isNews = currentPath.startsWith('/news');
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-surface-dark/95 border-b border-surface-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 sm:h-22">
      
      <!-- Brand Logo (Enlarged for clear legibility of 'RC Dynamo Ruhr') -->
      <a 
        href="/" 
        class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-lg py-1 shrink-0" 
        aria-label="RC Dynamo Ruhr e.V. – Zurück zur Startseite"
      >
        <picture>
          <source srcset="/images/logo.webp" type="image/webp" />
          <img 
            src="/images/logo.png" 
            alt="RC Dynamo Ruhr e.V. – Radsportverein für Rennrad & Gravel im Ruhrgebiet" 
            class="h-12 sm:h-14 md:h-16 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
            width="357" 
            height="160"
          />
        </picture>
      </a>

      <!-- Desktop Navigation Links (Pure text color highlight, no button/border style) -->
      <nav id="desktop-nav" class="hidden lg:flex items-center space-x-1 xl:space-x-2 text-sm font-medium" aria-label="Hauptnavigation">
        <a 
          href={isHome ? "#hero" : "/"} 
          data-nav-section="hero"
          class={`desktop-nav-link px-2.5 xl:px-3 py-2 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md ${isHome ? 'text-primary font-bold' : 'text-gray-200 hover:text-primary'}`}
          aria-current={isHome ? 'page' : undefined}
        >
          Home
        </a>
        <a 
          href={isHome ? "#groupride" : "/#groupride"} 
          data-nav-section="groupride"
          class="desktop-nav-link px-2.5 xl:px-3 py-2 text-gray-200 hover:text-primary transition-colors duration-200 flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md"
        >
          <span>Grouprides</span>
          <span class="inline-block w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
        </a>
        <a 
          href={isHome ? "#babos" : "/#babos"} 
          data-nav-section="babos"
          class="desktop-nav-link px-2.5 xl:px-3 py-2 text-gray-200 hover:text-primary transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md"
        >
          Club
        </a>
        <a 
          href={isHome ? "#vorteile" : "/#vorteile"} 
          data-nav-section="vorteile"
          class="desktop-nav-link px-2.5 xl:px-3 py-2 text-gray-200 hover:text-primary transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md"
        >
          Vorteile
        </a>
        <a 
          href={isHome ? "#news" : "/news"} 
          data-nav-section="news"
          class={`desktop-nav-link px-2.5 xl:px-3 py-2 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md ${isNews ? 'text-primary font-bold' : 'text-gray-200 hover:text-primary'}`}
          aria-current={isNews ? 'page' : undefined}
        >
          News
        </a>
        <a 
          href={isHome ? "#faq" : "/#faq"} 
          data-nav-section="faq"
          class="desktop-nav-link px-2.5 xl:px-3 py-2 text-gray-200 hover:text-primary transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md"
        >
          FAQ
        </a>
        <a 
          href={isHome ? "#kontakt" : "/#kontakt"} 
          data-nav-section="kontakt"
          class="desktop-nav-link px-2.5 xl:px-3 py-2 text-gray-200 hover:text-primary transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md"
        >
          Kontakt
        </a>
      </nav>

      <!-- Social Icons & CTA Button -->
      <div class="hidden sm:flex items-center space-x-3 lg:space-x-4">
        <!-- Socials (Desktop >= 1024px) -->
        <div class="hidden lg:flex items-center space-x-2 border-r border-surface-border pr-3 lg:pr-4">
          <!-- Strava -->
          <a 
            href={club.stravaClubUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="min-w-[40px] min-h-[40px] flex items-center justify-center p-2 text-gray-300 hover:text-[#FC6100] hover:bg-surface-card rounded-full transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
            aria-label="RC Dynamo Ruhr auf Strava (öffnet in neuem Tab)"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.93 15.773h4.173"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a 
            href={club.instagramUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="min-w-[40px] min-h-[40px] flex items-center justify-center p-2 text-gray-300 hover:text-[#E4405F] hover:bg-surface-card rounded-full transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
            aria-label="RC Dynamo Ruhr auf Instagram (öffnet in neuem Tab)"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>

        <!-- CTA Button (Touch target 44px+) -->
        <a 
          href={club.membershipPdfPath} 
          target="_blank" 
          rel="noopener noreferrer" 
          download 
          class="inline-flex items-center gap-2 px-3.5 xl:px-4 py-2.5 min-h-[44px] rounded-lg bg-primary hover:bg-primary-hover text-white text-xs xl:text-sm font-semibold tracking-wide shadow-md transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary active:scale-95 shrink-0"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Mitglied werden</span>
          <span class="sr-only">(PDF Download, öffnet in neuem Tab)</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button (Touch target 48x48px, visible on screens < lg) -->
      <div class="flex items-center lg:hidden">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="min-w-[48px] min-h-[48px] flex items-center justify-center p-2 text-gray-200 hover:text-white hover:bg-surface-card rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
          aria-expanded="false" 
          aria-controls="mobile-menu"
          aria-label="Menü öffnen"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <nav id="mobile-menu" class="hidden lg:hidden bg-surface-card border-b border-surface-border px-4 pt-3 pb-6 space-y-1.5" aria-label="Mobile Navigation">
    <a 
      href={isHome ? "#hero" : "/"} 
      data-nav-section="hero"
      class={`mobile-nav-link block px-3.5 py-3 rounded-lg text-base font-medium transition-colors ${isHome ? 'text-primary font-bold bg-surface-dark' : 'text-gray-100 hover:text-primary hover:bg-surface-dark'}`} 
      aria-current={isHome ? 'page' : undefined}
    >
      Home
    </a>
    <a 
      href={isHome ? "#groupride" : "/#groupride"} 
      data-nav-section="groupride"
      class="mobile-nav-link flex items-center justify-between px-3.5 py-3 rounded-lg text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark transition-colors"
    >
      <span>Grouprides</span>
      <span class="inline-flex items-center gap-1.5 text-xs text-primary font-semibold bg-primary/10 px-2.5 py-1 rounded-full border border-primary/20">
        <span class="w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        <span>Ausfahrten</span>
      </span>
    </a>
    <a 
      href={isHome ? "#babos" : "/#babos"} 
      data-nav-section="babos"
      class="mobile-nav-link block px-3.5 py-3 rounded-lg text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark transition-colors"
    >
      Club & Babos
    </a>
    <a 
      href={isHome ? "#vorteile" : "/#vorteile"} 
      data-nav-section="vorteile"
      class="mobile-nav-link block px-3.5 py-3 rounded-lg text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark transition-colors"
    >
      Vorteile
    </a>
    <a 
      href={isHome ? "#news" : "/news"} 
      data-nav-section="news"
      class={`mobile-nav-link block px-3.5 py-3 rounded-lg text-base font-medium transition-colors ${isNews ? 'text-primary font-bold bg-surface-dark' : 'text-gray-100 hover:text-primary hover:bg-surface-dark'}`} 
      aria-current={isNews ? 'page' : undefined}
    >
      News
    </a>
    <a 
      href={isHome ? "#faq" : "/#faq"} 
      data-nav-section="faq"
      class="mobile-nav-link block px-3.5 py-3 rounded-lg text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark transition-colors"
    >
      FAQ (Häufige Fragen)
    </a>
    <a 
      href={isHome ? "#kontakt" : "/#kontakt"} 
      data-nav-section="kontakt"
      class="mobile-nav-link block px-3.5 py-3 rounded-lg text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark transition-colors"
    >
      Kontakt
    </a>
    
    <div class="pt-4 mt-2 border-t border-surface-border/60 flex items-center justify-between gap-3">
      <div class="flex items-center space-x-1">
        <a 
          href={club.stravaClubUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="min-w-[44px] min-h-[44px] flex items-center justify-center p-2 text-gray-200 hover:text-[#FC6100] hover:bg-surface-dark rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
          aria-label="Strava Club (öffnet in neuem Tab)"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.93 15.773h4.173"/></svg>
        </a>
        <a 
          href={club.instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="min-w-[44px] min-h-[44px] flex items-center justify-center p-2 text-gray-200 hover:text-[#E4405F] hover:bg-surface-dark rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
          aria-label="Instagram (öffnet in neuem Tab)"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
      <a 
        href={club.membershipPdfPath} 
        target="_blank" 
        rel="noopener noreferrer" 
        download 
        class="inline-flex items-center gap-1.5 px-3.5 py-2.5 min-h-[44px] rounded-lg bg-primary hover:bg-primary-hover text-white text-xs sm:text-sm font-semibold shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-primary active:scale-95"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Mitgliedsantrag (PDF)</span>
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function initNavigation() {
    // 1. Mobile Menu Toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    function toggleMenu(open) {
      if (!menuBtn || !mobileMenu || !hamburgerIcon || !closeIcon) return;
      const isCurrentlyExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      const nextState = typeof open === 'boolean' ? open : !isCurrentlyExpanded;

      menuBtn.setAttribute('aria-expanded', String(nextState));
      menuBtn.setAttribute('aria-label', nextState ? 'Menü schließen' : 'Menü öffnen');

      if (nextState) {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    }

    if (menuBtn && mobileMenu && hamburgerIcon && closeIcon) {
      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
          toggleMenu(false);
          menuBtn.focus();
        }
      });

      // Close menu on outside click
      document.addEventListener('click', (event) => {
        if (
          menuBtn.getAttribute('aria-expanded') === 'true' &&
          !mobileMenu.contains(event.target) &&
          !menuBtn.contains(event.target)
        ) {
          toggleMenu(false);
        }
      });
    }

    // 2. Navigation Highlighting & Scrollspy (Universal for Desktop & Mobile)
    const sectionIds = ['hero', 'groupride', 'babos', 'vorteile', 'news', 'faq', 'kontakt'];
    const sections = sectionIds
      .map(id => document.getElementById(id))
      .filter(el => el !== null);

    // Only run scrollspy if homepage sections exist
    if (sections.length < 2) return;

    let currentActiveId = null;
    let lockedSectionId = null;
    let unlockTimeout = null;

    function applyHighlight(activeId) {
      if (!activeId || currentActiveId === activeId) return;
      currentActiveId = activeId;

      // Update Desktop links
      document.querySelectorAll('.desktop-nav-link[data-nav-section]').forEach(link => {
        const sec = link.getAttribute('data-nav-section');
        if (sec === activeId) {
          link.classList.add('text-primary', 'font-bold');
          link.classList.remove('text-gray-200');
          link.setAttribute('aria-current', 'true');
        } else {
          link.classList.remove('text-primary', 'font-bold');
          link.classList.add('text-gray-200');
          link.removeAttribute('aria-current');
        }
      });

      // Update Mobile links
      document.querySelectorAll('.mobile-nav-link[data-nav-section]').forEach(link => {
        const sec = link.getAttribute('data-nav-section');
        if (sec === activeId) {
          link.classList.add('text-primary', 'font-bold', 'bg-surface-dark');
          link.classList.remove('text-gray-100');
          link.setAttribute('aria-current', 'true');
        } else {
          link.classList.remove('text-primary', 'font-bold', 'bg-surface-dark');
          link.classList.add('text-gray-100');
          link.removeAttribute('aria-current');
        }
      });
    }

    function lockActiveSection(secId) {
      lockedSectionId = secId;
      applyHighlight(secId);
      if (unlockTimeout) clearTimeout(unlockTimeout);
      unlockTimeout = setTimeout(() => {
        lockedSectionId = null;
      }, 900);
    }

    // Immediately release lock on manual user scroll/touch interaction
    window.addEventListener('wheel', () => { lockedSectionId = null; }, { passive: true });
    window.addEventListener('touchstart', () => { lockedSectionId = null; }, { passive: true });

    function handleScroll() {
      if (lockedSectionId) return;

      const scrollY = window.scrollY;

      // 1. If at the top of page -> Hero
      if (scrollY < 100) {
        applyHighlight('hero');
        return;
      }

      // 2. If near bottom of document -> Kontakt
      if (window.innerHeight + scrollY >= document.documentElement.scrollHeight - 60) {
        applyHighlight('kontakt');
        return;
      }

      // 3. Monotonic section boundary check (trigger point = 160px from viewport top)
      const triggerY = 160;
      let activeId = 'hero';

      for (let i = 0; i < sections.length; i++) {
        const rect = sections[i].getBoundingClientRect();
        if (rect.top <= triggerY) {
          activeId = sections[i].id;
        } else {
          break;
        }
      }

      applyHighlight(activeId);
    }

    // Click handler for all in-page nav links (Desktop & Mobile)
    document.querySelectorAll('[data-nav-section]').forEach(link => {
      link.addEventListener('click', (e) => {
        const sec = link.getAttribute('data-nav-section');
        if (!sec) return;

        const target = document.getElementById(sec);
        if (target) {
          e.preventDefault();
          lockActiveSection(sec);
          toggleMenu(false);

          target.scrollIntoView({ behavior: 'smooth', block: 'start' });

          if (history.pushState) {
            history.pushState(null, '', `#${sec}`);
          }
        }
      });
    });

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      lockedSectionId = null;
      handleScroll();
    }, { passive: true });

    // Initial check on load
    if (window.location.hash) {
      const hash = window.location.hash.replace('#', '');
      if (sectionIds.includes(hash)) {
        lockActiveSection(hash);
      } else {
        handleScroll();
      }
    } else {
      handleScroll();
    }
  })();
</script>
