---
import club from '../data/club.json';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-surface-dark/90 border-b border-surface-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-lg py-1" aria-label="RC Dynamo Ruhr e.V. Startseite">
        <img 
          src="/images/logo.svg" 
          alt="RC Dynamo Ruhr e.V. – Radsportverein für Rennrad & Gravel im Ruhrgebiet" 
          class="h-10 w-auto transition-transform duration-300 group-hover:scale-105"
          width="180" 
          height="45"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-6 text-sm font-medium" aria-label="Hauptnavigation">
        <a 
          href="/" 
          class="px-3 py-2 text-gray-100 hover:text-primary transition-colors duration-200 rounded-md"
        >
          Home
        </a>
        <a 
          href="/#groupride" 
          class="px-3 py-2 text-gray-100 hover:text-primary transition-colors duration-200 rounded-md flex items-center gap-1.5"
        >
          <span>Groupride</span>
          <span class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse" title="Aktive Ausfahrten"></span>
        </a>
        <a 
          href="/#babos" 
          class="px-3 py-2 text-gray-100 hover:text-primary transition-colors duration-200 rounded-md"
        >
          Der Club
        </a>
        <a 
          href="/news" 
          class="px-3 py-2 text-gray-100 hover:text-primary transition-colors duration-200 rounded-md"
        >
          News
        </a>
        <a 
          href="/#kontakt" 
          class="px-3 py-2 text-gray-100 hover:text-primary transition-colors duration-200 rounded-md"
        >
          Kontakt
        </a>
      </nav>

      <!-- Social Icons & CTA Button -->
      <div class="hidden sm:flex items-center space-x-4">
        <!-- Socials -->
        <div class="flex items-center space-x-2 border-r border-surface-border pr-4">
          <!-- Strava -->
          <a 
            href={club.stravaClubUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2 text-gray-400 hover:text-[#FC6100] hover:bg-surface-card rounded-full transition-colors" 
            aria-label="RC Dynamo Ruhr auf Strava"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.93 15.773h4.173"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a 
            href={club.instagramUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2 text-gray-400 hover:text-[#E4405F] hover:bg-surface-card rounded-full transition-colors" 
            aria-label="RC Dynamo Ruhr auf Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>

        <!-- CTA Button -->
        <a 
          href={club.membershipPdfPath} 
          target="_blank"
          rel="noopener noreferrer"
          download 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary hover:bg-primary-hover text-white text-sm font-semibold tracking-wide shadow-md transition-all duration-200 active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Mitglied werden</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center sm:hidden">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 text-gray-300 hover:text-white hover:bg-surface-card rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-primary" 
          aria-expanded="false" 
          aria-controls="mobile-menu"
          aria-label="Menü öffnen"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden sm:hidden bg-surface-card border-b border-surface-border px-4 pt-3 pb-6 space-y-2">
    <a href="/" class="mobile-nav-link block px-3 py-2.5 rounded-md text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark">Home</a>
    <a href="/#groupride" class="mobile-nav-link block px-3 py-2.5 rounded-md text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark">Groupride</a>
    <a href="/#babos" class="mobile-nav-link block px-3 py-2.5 rounded-md text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark">Der Club</a>
    <a href="/news" class="mobile-nav-link block px-3 py-2.5 rounded-md text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark">News</a>
    <a href="/#kontakt" class="mobile-nav-link block px-3 py-2.5 rounded-md text-base font-medium text-gray-100 hover:text-primary hover:bg-surface-dark">Kontakt</a>
    
    <div class="pt-4 border-t border-surface-border/60 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a href={club.stravaClubUrl} target="_blank" rel="noopener noreferrer" class="p-2 text-gray-300 hover:text-primary" aria-label="Strava">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.93 15.773h4.173"/></svg>
        </a>
        <a href={club.instagramUrl} target="_blank" rel="noopener noreferrer" class="p-2 text-gray-300 hover:text-primary" aria-label="Instagram">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
      <a 
        href={club.membershipPdfPath} 
        target="_blank"
        rel="noopener noreferrer"
        download 
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md bg-primary hover:bg-primary-hover text-white text-xs font-semibold"
      >
        <span>Mitgliedsantrag (PDF)</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Minimal, resilient, zero-framework mobile navigation logic
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuBtn && mobileMenu && hamburgerIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close on click link
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
