---
import club from '../data/club.json';
import { getJoinrideStatus, JOINRIDE_CLUB_URL } from '../lib/joinride';

// Query Joinride API at build / SSR time
const joinrideStatus = await getJoinrideStatus();
const hasInitialRide = joinrideStatus.hasActiveRide && joinrideStatus.ride !== null;
const initialRide = joinrideStatus.ride;
---

<section id="groupride" class="py-20 lg:py-28 bg-surface-card/50 border-b border-surface-border relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-bold uppercase tracking-wider mb-3">
        Zusammen rollen
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white uppercase tracking-tight">
        Der nächste Groupride
      </h2>
      <p class="text-gray-400 mt-3 text-base sm:text-lg">
        Gemeinsam los, gemeinsam ankommen. Niemand wird zurückgelassen.
      </p>
    </div>

    <!-- Dynamic Container with aria-live for a11y -->
    <div id="groupride-container" aria-live="polite">

      <!-- 1. Active Ride Card (populated from Joinride) -->
      <div 
        id="groupride-active-card" 
        class={`bg-gradient-to-br from-surface-card to-surface-card border-2 border-primary/40 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-2xl relative overflow-hidden transition-all duration-300 hover:border-primary/70 ${hasInitialRide ? '' : 'hidden'}`}
      >
        <!-- Glowing corner accent -->
        <div class="absolute -top-24 -right-24 w-60 h-60 bg-primary/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

        <div class="relative z-10">
          <!-- Top Status Bar -->
          <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-surface-border">
            <div class="flex items-center gap-3">
              <span class="flex h-3.5 w-3.5 relative" aria-hidden="true">
                <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-green-500"></span>
              </span>
              <span id="groupride-status-badge" class="text-sm font-bold uppercase tracking-widest text-green-400">
                Ausfahrt auf Joinride bestätigt
              </span>
            </div>
            
            <!-- Date & Time Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-dark border border-surface-border text-white text-sm sm:text-base font-semibold">
              <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span id="groupride-date">{initialRide?.formattedDate || ''}</span>
            </div>
          </div>

          <!-- Ride Title -->
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span id="groupride-type-badge" class="px-3 py-1 rounded-lg bg-primary/20 text-primary border border-primary/30 text-xs font-bold uppercase tracking-wider">
              {initialRide?.subTypeLabel || 'Rennrad'}
            </span>
          </div>
          <h3 id="groupride-title" class="text-2xl sm:text-4xl font-extrabold text-white mb-8 font-display tracking-tight">
            {initialRide?.title || ''}
          </h3>

          <!-- Ride Key Badges Grid -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-10">
            <!-- Distanz -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-300 uppercase tracking-wider block mb-1">Distanz</span>
              <span id="groupride-distance" class="text-2xl sm:text-3xl font-black text-white font-display">
                {initialRide?.distanceKm ?? '–'}
              </span>
              <span class="text-primary font-bold text-sm ml-1">km</span>
            </div>

            <!-- Höhenmeter -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-300 uppercase tracking-wider block mb-1">Höhenmeter</span>
              <span id="groupride-elevation" class="text-2xl sm:text-3xl font-black text-white font-display">
                {initialRide?.elevationM ? `+${initialRide.elevationM}` : '–'}
              </span>
              <span class="text-primary font-bold text-sm ml-1">hm</span>
            </div>

            <!-- Tempo -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-300 uppercase tracking-wider block mb-1">Ziel-Tempo</span>
              <span id="groupride-pace" class="text-xl sm:text-2xl font-black text-white font-display">
                {initialRide?.pace ?? '–'}
              </span>
              <span class="text-xs text-gray-300 block mt-1">zusammen rollen</span>
            </div>

            <!-- Treffpunkt -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-300 uppercase tracking-wider block mb-1">Treffpunkt</span>
              <span id="groupride-meeting-point" class="text-sm sm:text-base font-bold text-white block truncate" title={initialRide?.meetingPoint || ''}>
                {initialRide?.meetingPoint || '–'}
              </span>
              <span class="text-xs text-primary font-semibold block mt-1">Pünktlich am Rad</span>
            </div>
          </div>

          <!-- Additional Rules & Tour Info -->
          <div class="bg-primary/10 border border-primary/20 rounded-2xl p-5 mb-8 flex items-start gap-4">
            <div class="p-2 bg-primary/20 text-primary rounded-xl shrink-0 mt-0.5" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-1">Wichtig für alle Mitfahrenden:</h4>
              <p id="groupride-info" class="text-sm text-gray-200 leading-relaxed">
                {initialRide?.info || 'Helmpflicht! Wir fahren zusammen und warten aufeinander. Niemand wird zurückgelassen.'}
              </p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center gap-4">
            <!-- Joinride CTA -->
            <a 
              id="groupride-joinride-link"
              href={initialRide?.url || JOINRIDE_CLUB_URL} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="min-h-[48px] inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-sm tracking-wide shadow-md transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
            >
              <span>Auf Joinride teilnehmen</span>
              <span class="sr-only">(öffnet in neuem Tab)</span>
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>

            <!-- Instagram CTA -->
            <a 
              href={club.instagramUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="min-h-[48px] inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-surface-dark hover:bg-dark-border border border-surface-border text-gray-200 hover:text-white font-semibold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <svg class="w-4 h-4 fill-current text-[#E1306C]" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Updates via Instagram</span>
              <span class="sr-only">(öffnet in neuem Tab)</span>
            </a>

            <!-- Strava Club Secondary -->
            <a 
              href={club.stravaClubUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="min-h-[48px] inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-surface-dark hover:bg-dark-border border border-surface-border text-gray-200 hover:text-white font-semibold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <svg class="w-4 h-4 fill-[#FC6100]" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.93 15.773h4.173"/>
              </svg>
              <span>Strava Club</span>
              <span class="sr-only">(öffnet in neuem Tab)</span>
            </a>
          </div>

        </div>
      </div>

      <!-- 2. Empty Notice Card (Shown when NO groupride is scheduled) -->
      <div 
        id="groupride-empty-notice" 
        class={`bg-surface-card border border-surface-border rounded-3xl p-8 sm:p-12 text-center max-w-2xl mx-auto shadow-xl relative overflow-hidden transition-all duration-300 ${hasInitialRide ? 'hidden' : ''}`}
      >
        <!-- Subtle background glow -->
        <div class="absolute -top-16 -right-16 w-44 h-44 bg-primary/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

        <div class="relative z-10">
          <!-- Calendar / Status Icon -->
          <div class="w-16 h-16 bg-primary/10 border border-primary/20 rounded-2xl flex items-center justify-center mx-auto mb-6 text-primary shadow-sm" aria-hidden="true">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>

          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-dark border border-surface-border text-gray-300 text-xs font-semibold uppercase tracking-wider mb-4">
            <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
            <span>Status: In Planung</span>
          </div>

          <!-- Main Notice Title -->
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-4 font-display">
            Aktuell kein fester Groupride geplant
          </h3>

          <!-- User requested explanatory notice text -->
          <p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-8 max-w-lg mx-auto">
            Wir planen gerade die nächsten Touren durchs Revier! Aktuell steht kein fester Groupride im Kalender. Folge uns gern auf Instagram, um bei spontanen Ausfahrten und neuen Terminen immer auf dem Laufenden zu bleiben.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <!-- Instagram CTA (Prominent) -->
            <a 
              href={club.instagramUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-xl bg-gradient-to-r from-[#E1306C] via-[#FD1D1D] to-[#F77737] hover:opacity-95 text-white font-bold text-base shadow-lg transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Auf Instagram folgen</span>
              <span class="sr-only">(öffnet in neuem Tab)</span>
            </a>

            <!-- Joinride Club Link -->
            <a 
              href={JOINRIDE_CLUB_URL} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-surface-dark hover:bg-dark-border border border-surface-border text-gray-200 hover:text-white font-semibold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <span>Joinride Aktivitäten</span>
              <span class="sr-only">(öffnet in neuem Tab)</span>
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- 3-Steps "Wie rollst du mit uns?" Guide -->
    <div class="mt-16 pt-14 border-t border-surface-border/60">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-primary mb-2">Unverbindlich reinschnuppern</span>
        <h3 class="text-xl sm:text-2xl font-black text-white font-display">In 3 Schritten zum ersten Ride</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="bg-surface-card/60 border border-surface-border rounded-2xl p-6 relative">
          <div class="w-9 h-9 rounded-xl bg-primary/20 text-primary font-black font-display flex items-center justify-center text-sm mb-4">
            01
          </div>
          <h4 class="text-base font-bold text-white mb-2 font-display">Ride aussuchen</h4>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Check die Tourdaten auf Joinride oder schau in unsere Instagram Story. Distanz, Höhenmeter und Streckentyp sind immer transparent angegeben.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="bg-surface-card/60 border border-surface-border rounded-2xl p-6 relative">
          <div class="w-9 h-9 rounded-xl bg-primary/20 text-primary font-black font-display flex items-center justify-center text-sm mb-4">
            02
          </div>
          <h4 class="text-base font-bold text-white mb-2 font-display">Pünktlich am Start sein</h4>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Komm einfach zum Treffpunkt. Wichtig: Helmpflicht, ein funktionierendes Rennrad oder Gravelbike und ein Ersatzschlauch in der Tasche.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="bg-surface-card/60 border border-surface-border rounded-2xl p-6 relative">
          <div class="w-9 h-9 rounded-xl bg-primary/20 text-primary font-black font-display flex items-center justify-center text-sm mb-4">
            03
          </div>
          <h4 class="text-base font-bold text-white mb-2 font-display">Zusammen ankommen</h4>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            No-Drop-Garantie: Wir warten aufeinander, niemand wird abgehängt. Nach der Ausfahrt gibt’s entspannten Schnack und Kaltgetränke.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Client-side Listening Function for Joinride Activities -->
<script is:inline>
  (function initJoinrideListener() {
    const activeCard = document.getElementById('groupride-active-card');
    const emptyNotice = document.getElementById('groupride-empty-notice');

    const titleEl = document.getElementById('groupride-title');
    const dateEl = document.getElementById('groupride-date');
    const distEl = document.getElementById('groupride-distance');
    const elevEl = document.getElementById('groupride-elevation');
    const paceEl = document.getElementById('groupride-pace');
    const meetEl = document.getElementById('groupride-meeting-point');
    const typeBadgeEl = document.getElementById('groupride-type-badge');
    const infoEl = document.getElementById('groupride-info');
    const linkEl = document.getElementById('groupride-joinride-link');

    function renderRide(ride) {
      if (!activeCard || !emptyNotice) return;

      if (!ride || ride.isCanceled) {
        // No planned ride: hide active card, show notice
        activeCard.classList.add('hidden');
        emptyNotice.classList.remove('hidden');
        return;
      }

      // Populate ride attributes from Joinride
      if (titleEl && ride.title) titleEl.textContent = ride.title;
      if (dateEl && ride.formattedDate) dateEl.textContent = ride.formattedDate;
      if (distEl) distEl.textContent = ride.distanceKm !== null ? String(ride.distanceKm) : '–';
      if (elevEl) elevEl.textContent = ride.elevationM !== null ? `+${ride.elevationM}` : '–';
      if (paceEl) paceEl.textContent = ride.pace || '–';
      if (meetEl && ride.meetingPoint) {
        meetEl.textContent = ride.meetingPoint;
        meetEl.setAttribute('title', ride.meetingPoint);
      }
      if (typeBadgeEl && ride.subTypeLabel) typeBadgeEl.textContent = ride.subTypeLabel;
      if (infoEl && ride.info) infoEl.textContent = ride.info;
      if (linkEl && ride.url) linkEl.setAttribute('href', ride.url);

      // Reveal active ride card, hide empty notice
      activeCard.classList.remove('hidden');
      emptyNotice.classList.add('hidden');
    }

    async function checkJoinrideLive() {
      try {
        const res = await fetch('/api/joinride.json', {
          headers: { 'Accept': 'application/json' },
          cache: 'no-cache',
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        
        if (data && data.hasActiveRide && data.ride) {
          renderRide(data.ride);
        } else {
          renderRide(null);
        }
      } catch (err) {
        // Silently preserve current SSR state if offline or network error
        console.debug('[Joinride Listener] Poll completed with fallback:', err);
      }
    }

    // Expose simulation helper on window for easy testing/demo
    window.__simulateJoinride = function(enableOrCustom) {
      if (enableOrCustom === false) {
        renderRide(null);
        console.log('[Joinride Demo] Switched to: No planned ride (Instagram notice)');
        return;
      }

      const sampleRide = typeof enableOrCustom === 'object' && enableOrCustom !== null ? enableOrCustom : {
        id: 'sample-ride',
        title: 'RR I Bredevoort 162km | Dynamo Ruhr Ausfahrt',
        date: new Date(Date.now() + 86400000 * 3).toISOString(),
        formattedDate: 'Samstag, 10. Oktober 2026, 09:00 Uhr',
        slug: 'rr-i-bredevoort-162km-yTgTGiSPF',
        url: 'https://joinride.cc/pro/rc-dynamo-ruhr/activities',
        meetingPoint: 'Turfstraße 15, 45899 Gelsenkirchen (Schwimmhalle Horst)',
        distanceKm: 162,
        elevationM: 450,
        pace: '25–28 km/h',
        subType: 'ROADBIKE',
        subTypeLabel: 'Rennrad',
        info: 'Vereinsausfahrt des RC Dynamo Ruhr e.V. – 162 km Rennradspaß. Wir fahren zügig, warten aufeinander und machen Pause in Bredevoort. Helmpflicht!',
        isCanceled: false,
      };

      renderRide(sampleRide);
      console.log('[Joinride Demo] Switched to: Active Ride planned on Joinride', sampleRide);
    };

    // Check URL query parameters for test flags (e.g. ?test_ride=true or ?simulate_ride=1)
    try {
      const params = new URLSearchParams(window.location.search);
      if (params.has('test_ride') || params.has('simulate_ride')) {
        window.__simulateJoinride(true);
        return;
      }
    } catch (_) {}

    // Run live listener check on page load
    checkJoinrideLive();

    // Re-check when window regains focus (e.g. user created ride in another tab)
    window.addEventListener('focus', () => {
      checkJoinrideLive();
    });
  })();
</script>
