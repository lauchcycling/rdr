---
import events from '../data/events.json';
import club from '../data/club.json';

// Formatted German Date display
let formattedDate = "";
try {
  const eventDate = new Date(events.date);
  formattedDate = new Intl.DateTimeFormat('de-DE', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(eventDate) + ' Uhr';
} catch (e) {
  formattedDate = events.date;
}
---

<section id="groupride" class="py-20 lg:py-28 bg-surface-card/50 border-b border-surface-border relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-bold uppercase tracking-wider mb-3">
        Zusammen rollen
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white uppercase tracking-tight">
        Der nächste Groupride
      </h2>
      <p class="text-gray-400 mt-3 text-base sm:text-lg">
        Gemeinsam los, gemeinsam ankommen. Niemand wird zurückgelassen.
      </p>
    </div>

    {events.active ? (
      <!-- Active Ride Card -->
      <div class="bg-gradient-to-br from-surface-card to-surface-card border-2 border-primary/40 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-2xl relative overflow-hidden transition-all duration-300 hover:border-primary/70">
        
        <!-- Glowing corner accent -->
        <div class="absolute -top-24 -right-24 w-60 h-60 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          
          <!-- Top Status Bar -->
          <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-surface-border">
            <div class="flex items-center gap-3">
              <span class="flex h-3.5 w-3.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-green-500"></span>
              </span>
              <span class="text-sm font-bold uppercase tracking-widest text-green-400">Ausfahrt bestätigt</span>
            </div>
            
            <!-- Date & Time badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-dark border border-surface-border text-white text-sm sm:text-base font-semibold">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span>{formattedDate}</span>
            </div>
          </div>

          <!-- Ride Title -->
          <h3 class="text-2xl sm:text-4xl font-extrabold text-white mb-8 font-display tracking-tight">
            {events.title}
          </h3>

          <!-- Ride Key Badges Grid -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-10">
            <!-- Distanz -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Distanz</span>
              <span class="text-2xl sm:text-3xl font-black text-white font-display">{events.distanceKm}</span>
              <span class="text-primary font-bold text-sm ml-1">km</span>
            </div>

            <!-- Höhenmeter -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Höhenmeter</span>
              <span class="text-2xl sm:text-3xl font-black text-white font-display">+{events.elevationM}</span>
              <span class="text-primary font-bold text-sm ml-1">hm</span>
            </div>

            <!-- Tempo -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Ziel-Tempo</span>
              <span class="text-xl sm:text-2xl font-black text-white font-display">{events.pace.split(' ')[0]}</span>
              <span class="text-xs text-gray-400 block mt-1">zusammen rollen</span>
            </div>

            <!-- Treffpunkt -->
            <div class="bg-surface-dark/80 border border-surface-border/80 rounded-2xl p-4 sm:p-5 text-center transition-transform hover:-translate-y-1">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Treffpunkt</span>
              <span class="text-sm sm:text-base font-bold text-white block truncate" title={events.meetingPoint}>{events.meetingPoint}</span>
              <span class="text-xs text-primary font-medium block mt-1">Pünktlich am Rad</span>
            </div>
          </div>

          <!-- Additional Rules & Kaltgetränke Info -->
          <div class="bg-primary/10 border border-primary/20 rounded-2xl p-5 mb-8 flex items-start gap-4">
            <div class="p-2 bg-primary/20 text-primary rounded-xl shrink-0 mt-0.5">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-1">Wichtig für alle Mitfahrenden:</h4>
              <p class="text-sm text-gray-300 leading-relaxed">
                {events.info}
              </p>
            </div>
          </div>

          <!-- Action Buttons (Strava Club, Komoot, etc.) -->
          <div class="flex flex-wrap items-center gap-4">
            {events.stravaEventUrl ? (
              <a 
                href={events.stravaEventUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#FC6100] hover:bg-[#e05600] text-white font-bold text-sm tracking-wide shadow-md transition-all"
              >
                <span>Auf Strava zusagen</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.93 15.773h4.173"/></svg>
              </a>
            ) : (
              <a 
                href={club.stravaClubUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#FC6100] hover:bg-[#e05600] text-white font-bold text-sm tracking-wide shadow-md transition-all"
              >
                <span>Im Strava-Club mitfahren</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.93 15.773h4.173"/></svg>
              </a>
            )}

            <a 
              href={club.instagramUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-surface-dark hover:bg-dark-border border border-surface-border text-gray-200 hover:text-white font-semibold text-sm transition-all"
            >
              <span>Updates via Instagram Story</span>
            </a>
          </div>

        </div>
      </div>
    ) : (
      <!-- Inactive State -->
      <div class="bg-surface-card border border-surface-border rounded-3xl p-8 sm:p-12 text-center max-w-2xl mx-auto">
        <div class="w-16 h-16 bg-dark-border/50 rounded-2xl flex items-center justify-center mx-auto mb-5 text-gray-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">Aktuell kein fester Ride geplant</h3>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed mb-6">
          Wir planen gerade die nächsten Strecken durchs Revier! Spontane Ausfahrten kündigen wir kurzfristig in unserem Strava Club und auf Instagram an.
        </p>
        <div class="flex justify-center gap-4">
          <a href={club.stravaClubUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl bg-[#FC6100] text-white font-semibold text-sm">
            Strava Club
          </a>
          <a href={club.instagramUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl bg-surface-dark border border-surface-border text-white font-semibold text-sm">
            Instagram
          </a>
        </div>
      </div>
    )}

  </div>
</section>
