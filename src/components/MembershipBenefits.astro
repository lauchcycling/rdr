---
import club from '../data/club.json';

const benefits = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>`,
    title: "Exklusive Bioracer Team-Kits",
    description: "Hochwertige Vereinstrikots, Hosen und Windwesten im unverwechselbaren Dynamo Ruhr Design – professionelle Qualität zu fairen Club-Konditionen."
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    title: "Aktive Community & Chat",
    description: "Direkter Draht in unserer WhatsApp-Gruppe: Finde jederzeit Mitfahrer für spontane Feierabendrunden, Kettenschmiere-Talk und Fahrgemeinschaften."
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    title: "BDR-Schutz & Lizenzen",
    description: "Offizieller Anschluss an den Radsportverband NRW und den Bund Deutscher Radfahrer (BDR). Inklusive Sportversicherung, RTF-Wertungskarten und Lizenzoptionen."
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: "100% Leidenschaft, 0% Vereinsmeierei",
    description: "Keine Pflicht-Arbeitsstunden, keine staubigen Ausschusssitzungen. Wir machen das für den Spaß am Radsport und den gemeinsamen Tritt in die Pedale."
  }
];
---

<section id="vorteile" class="py-20 lg:py-28 bg-surface-card/40 border-b border-surface-border relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-bold uppercase tracking-wider mb-3">
        Vereinsleben
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display">
        Warum RC Dynamo Ruhr?
      </h2>
      <p class="text-gray-400 mt-3 text-base sm:text-lg">
        Gemeinsam rollen, Spaß haben und von handfesten Club-Vorteilen im Revier profitieren.
      </p>
    </div>

    <!-- 4 Value Pillar Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-16">
      {benefits.map((benefit) => (
        <div class="bg-surface-card border border-surface-border rounded-3xl p-8 sm:p-10 transition-all duration-300 hover:border-primary/50 hover:shadow-glow flex flex-col justify-between">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-primary/15 border border-primary/25 text-primary flex items-center justify-center mb-6" aria-hidden="true" set:html={benefit.icon} />
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 font-display">
              {benefit.title}
            </h3>
            <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
              {benefit.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Conversion Box: Antrag laden -->
    <div class="bg-gradient-to-r from-surface-dark via-surface-card to-surface-dark border-2 border-primary/30 rounded-3xl p-8 sm:p-12 text-center max-w-3xl mx-auto relative overflow-hidden shadow-2xl">
      <div class="absolute -top-20 -right-20 w-48 h-48 bg-primary/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      
      <div class="relative z-10">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-3 font-display">
          Lust auf Kette rechts mit uns?
        </h3>
        <p class="text-gray-300 text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed">
          Lade dir den Mitgliedsantrag als PDF herunter, fülle ihn bequem aus und sende ihn per Mail an <span class="text-primary font-semibold">{club.contactEmail}</span>. Wir freuen uns auf dich!
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href={club.membershipPdfPath} 
            target="_blank" 
            rel="noopener noreferrer" 
            download
            class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-sm sm:text-base tracking-wide shadow-md transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>Mitgliedsantrag laden (PDF)</span>
            <span class="sr-only">(öffnet in neuem Tab)</span>
          </a>

          <a 
            href="#groupride" 
            class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-surface-dark hover:bg-dark-border border border-surface-border text-gray-200 hover:text-white font-semibold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            <span>Erstmal unverbindlich mitrollen</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
