---
import club from '../data/club.json';
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center justify-center overflow-hidden bg-surface-dark border-b border-surface-border">
  
  <!-- Optimized Hero Background with Layered Gradients -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero.webp" 
      alt="RC Dynamo Ruhr e.V. Peloton Ausfahrt – Rennrad & Grouprides im Ruhrgebiet" 
      class="w-full h-full object-cover object-center filter brightness-40 sm:brightness-50 transform scale-105 transition-transform duration-1000 ease-out"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <!-- Rich gradients for maximum readability & aesthetic depth -->
    <div class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/80 to-surface-dark/40"></div>
    <div class="absolute inset-0 bg-radial-gradient"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-36 text-center sm:text-left">
    
    <!-- Top Eyebrow -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/20 border border-primary/40 backdrop-blur-sm text-primary text-xs sm:text-sm font-semibold uppercase tracking-wider mb-6">
      <span>Radsportclub im Ruhrgebiet • #8000watt</span>
    </div>

    <!-- Main Heading / Hero Typography -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-white uppercase leading-[1.05] mb-6">
      Radsport im Revier.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-[#FF7A45] to-[#FFA07A] text-glow">
        RC Dynamo Ruhr.
      </span>
    </h1>

    <!-- Slogan -->
    <p class="text-xl sm:text-2xl lg:text-3xl font-medium text-gray-200 max-w-3xl mb-4 italic font-display">
      „{club.slogan}“
    </p>

    <!-- Punchy Description -->
    <p class="text-base sm:text-lg text-gray-300 max-w-2xl mb-10 leading-relaxed font-sans">
      Gemeinsame Rennrad- und Gravel-Ausfahrten von Essen und Gelsenkirchen bis Recklinghausen. Zusammen los, zusammen ankommen – ohne Vereinsmeierei.
    </p>

    <!-- Focused CTA Group -->
    <div class="flex flex-col sm:flex-row items-center gap-4">
      <!-- Primary Action: Groupride -->
      <a 
        href="#groupride" 
        class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-base tracking-wide shadow-glow transition-all duration-300 hover:shadow-glow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-surface-dark"
      >
        <span>Nächster Groupride</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </a>

      <!-- Secondary Action: Download membership -->
      <a 
        href={club.membershipPdfPath} 
        target="_blank"
        rel="noopener noreferrer"
        download 
        class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-surface-card/90 hover:bg-surface-card border border-surface-border hover:border-gray-500 text-white font-semibold text-base transition-all duration-200 backdrop-blur-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-dark"
      >
        <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span>Mitgliedsantrag laden</span>
        <span class="sr-only">(PDF Download, öffnet in neuem Tab)</span>
      </a>
    </div>

  </div>
</section>
