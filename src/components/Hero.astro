---
import club from '../data/club.json';
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center justify-center overflow-hidden bg-surface-dark border-b border-surface-border">
  
  <!-- Optimized Hero Background with Layered Gradients -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero.webp" 
      alt="RC Dynamo Ruhr e.V. Peloton Ausfahrt – Rennrad & Grouprides im Ruhrgebiet" 
      class="w-full h-full object-cover object-center filter brightness-40 sm:brightness-50 transform scale-105 transition-transform duration-1000 ease-out"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <!-- Rich gradients for maximum readability & aesthetic depth -->
    <div class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/80 to-surface-dark/40"></div>
    <div class="absolute inset-0 bg-radial-gradient"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 text-center sm:text-left">
    
    <!-- Top Tags & Slogan -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/20 border border-primary/40 backdrop-blur-sm text-primary text-xs sm:text-sm font-semibold uppercase tracking-wider mb-6">
      <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
      <span>Rennrad • Gravel • Groupride Ruhrgebiet • #8000watt</span>
    </div>

    <!-- Main Heading / Hero Typography -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-white uppercase leading-[1.05] mb-6">
      Radsport im Revier.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-[#FF7A45] to-[#FFA07A] text-glow">
        RC Dynamo Ruhr.
      </span>
    </h1>

    <!-- Slogan & Subtitle -->
    <p class="text-xl sm:text-2xl lg:text-3xl font-medium text-gray-200 max-w-3xl mb-4 italic font-display">
      „{club.slogan}“
    </p>

    <!-- Claim Description with regional keywords -->
    <p class="text-base sm:text-lg text-gray-300 max-w-2xl mb-10 leading-relaxed font-sans">
      Dein moderner <strong>Radsportclub für Rennrad und Gravel</strong> im Ruhrgebiet. Regelmäßige Grouprides für Renn- und Genussradler*innen aus Essen, Gelsenkirchen, Recklinghausen, Bochum und Umgebung.
    </p>

    <!-- CTA Button Group -->
    <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-5">
      <!-- Primary Action: Groupride -->
      <a 
        href="#groupride" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-base tracking-wide shadow-glow transition-all duration-300 hover:shadow-glow-lg hover:-translate-y-0.5"
      >
        <span>Nächster Groupride</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </a>

      <!-- Secondary Action: Instagram -->
      <a 
        href={club.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl bg-surface-card/80 hover:bg-surface-card border border-surface-border hover:border-gray-500 text-white font-semibold text-base transition-all duration-200 backdrop-blur-sm"
      >
        <svg class="w-5 h-5 fill-[#E4405F]" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>Instagram @dynamo_ruhr</span>
      </a>

      <!-- Tertiary: Download membership -->
      <a 
        href={club.membershipPdfPath} 
        target="_blank"
        rel="noopener noreferrer"
        download 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-4 rounded-xl border border-transparent hover:border-surface-border text-gray-400 hover:text-white font-medium text-sm transition-colors"
      >
        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span>Mitgliedsantrag laden</span>
      </a>
    </div>

    <!-- Quick Stats Grid -->
    <div class="mt-14 pt-8 border-t border-surface-border/60 grid grid-cols-2 md:grid-cols-4 gap-6 text-left">
      <div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white font-display">100%</div>
        <div class="text-xs sm:text-sm text-gray-400 uppercase tracking-wider mt-0.5">Leidenschaft</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white font-display">0%</div>
        <div class="text-xs sm:text-sm text-gray-400 uppercase tracking-wider mt-0.5">Vereinsmeierei</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white font-display">8000</div>
        <div class="text-xs sm:text-sm text-gray-400 uppercase tracking-wider mt-0.5">Watt im Kopf</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white font-display">Ruhr</div>
        <div class="text-xs sm:text-sm text-gray-400 uppercase tracking-wider mt-0.5">Pott im Herzen</div>
      </div>
    </div>

  </div>
</section>
