---
import club from '../data/club.json';
---

<section id="kontakt" class="py-20 lg:py-28 bg-surface-dark border-b border-surface-border relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-bold uppercase tracking-wider mb-3">
        Quatschen & Mitfahren
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white uppercase tracking-tight font-display">
        Schreib uns!
      </h2>
      <p class="text-gray-400 mt-3 text-base sm:text-lg">
        Fragen zur Mitgliedschaft, zu den Ausfahrten oder einfach nur Hallöchen sagen? Wir beißen nicht – wir treten nur in die Pedale.
      </p>
    </div>

    <!-- Contact Form Card -->
    <div class="bg-surface-card border border-surface-border rounded-3xl p-6 sm:p-10 shadow-xl">
      <form 
        action={`mailto:${club.contactEmail}`} 
        method="POST" 
        enctype="text/plain"
        class="space-y-6"
        id="contact-form"
      >
        <!-- Name -->
        <div>
          <label for="name" class="block text-sm font-semibold text-gray-200 mb-2">
            Dein Name <span class="text-primary">*</span>
          </label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            placeholder="z. B. Jan Ullrich" 
            class="w-full px-4 py-3.5 rounded-xl bg-surface-dark border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm"
          />
        </div>

        <!-- E-Mail -->
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-200 mb-2">
            Deine E-Mail-Adresse <span class="text-primary">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="du@beispiel.de" 
            class="w-full px-4 py-3.5 rounded-xl bg-surface-dark border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm"
          />
        </div>

        <!-- Nachricht -->
        <div>
          <label for="message" class="block text-sm font-semibold text-gray-200 mb-2">
            Deine Nachricht <span class="text-primary">*</span>
          </label>
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Worüber möchtest du mit uns schnacken? Fragen zu Temposchnitten, Treffpunkten oder Trikots?" 
            class="w-full px-4 py-3.5 rounded-xl bg-surface-dark border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm resize-y"
          ></textarea>
        </div>

        <!-- DSGVO Checkbox -->
        <div class="flex items-start gap-3 pt-2">
          <input 
            type="checkbox" 
            id="privacy-consent" 
            name="privacy-consent" 
            required 
            class="mt-1 w-4 h-4 rounded border-surface-border text-primary focus:ring-primary focus:ring-offset-surface-card bg-surface-dark cursor-pointer"
          />
          <label for="privacy-consent" class="text-xs sm:text-sm text-gray-400 leading-normal cursor-pointer">
            Ich habe die <a href="/datenschutz" class="text-primary hover:underline font-medium">Datenschutzerklärung</a> zur Kenntnis genommen. Ich stimme zu, dass meine Angaben zur Kontaktaufnahme und für Rückfragen gespeichert und verarbeitet werden.
          </label>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <button 
            type="submit" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-sm uppercase tracking-wider shadow-glow hover:shadow-glow-lg transition-all duration-300 active:scale-98 flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
            <span>Nachricht abschicken</span>
          </button>
        </div>
      </form>

      <!-- Direct Email Callout -->
      <div class="mt-8 pt-6 border-t border-surface-border/60 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-gray-400">
        <span>Oder schreibe direkt an unser Club-Postfach:</span>
        <a 
          href={`mailto:${club.contactEmail}`} 
          class="text-primary hover:underline font-semibold flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>{club.contactEmail}</span>
        </a>
      </div>

    </div>

  </div>
</section>
