---
import club from '../data/club.json';

const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-dark border-t border-surface-border text-gray-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    
    <!-- Hidden Section Heading for Screen Readers (WCAG 1.3.1) -->
    <h2 class="sr-only">Fußzeilennavigation und Vereinsinformationen</h2>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 lg:gap-12 mb-12">
      
      <!-- Column 1: Brand & Slogan -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-lg py-1" aria-label="RC Dynamo Ruhr e.V. – Zurück zur Startseite">
          <picture>
            <source srcset="/images/logo.webp" type="image/webp" />
            <img 
              src="/images/logo.png" 
              alt="RC Dynamo Ruhr e.V. – Radsport im Revier" 
              class="h-10 sm:h-11 w-auto object-contain my-1" 
              width="180" 
              height="78"
            />
          </picture>
        </a>
        <p class="text-gray-200 font-medium italic font-display text-base">
          „{club.slogan}“
        </p>
        <p class="text-xs text-gray-300 max-w-md leading-relaxed">
          {club.claim}
        </p>
      </div>

      <!-- Column 2: Schnelle Links -->
      <nav aria-label="Fußzeilen-Navigation">
        <h3 class="text-white font-bold text-xs uppercase tracking-wider mb-4 font-display">Navigation</h3>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/" class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">Startseite</a></li>
          <li><a href="/#groupride" class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">Grouprides</a></li>
          <li><a href="/#babos" class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">Club</a></li>
          <li><a href="/#vorteile" class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">Vorteile</a></li>
          <li><a href="/news" class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">News</a></li>
          <li><a href="/#faq" class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">FAQ</a></li>
          <li><a href="/#kontakt" class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">Kontakt</a></li>
          <li>
            <a 
              href={club.membershipPdfPath} 
              target="_blank"
              rel="noopener noreferrer"
              download 
              class="text-primary hover:underline font-semibold flex items-center gap-1 focus-visible:ring-1 focus-visible:ring-primary rounded"
            >
              <span>Mitgliedsantrag (PDF)</span>
              <span class="sr-only">(öffnet neues Tab und startet Download)</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Column 3: Community & Rechtliches -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-wider mb-4 font-display">Community & Recht</h3>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href={club.stravaClubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#FC6100] transition-colors flex items-center gap-2 focus-visible:ring-1 focus-visible:ring-primary rounded">
              <span>Strava Club</span>
              <span class="sr-only">(externer Link, öffnet in neuem Tab)</span>
            </a>
          </li>
          <li>
            <a href={club.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#E4405F] transition-colors flex items-center gap-2 focus-visible:ring-1 focus-visible:ring-primary rounded">
              <span>Instagram @dynamoruhr</span>
              <span class="sr-only">(externer Link, öffnet in neuem Tab)</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${club.contactEmail}`} class="hover:text-primary transition-colors focus-visible:ring-1 focus-visible:ring-primary rounded">
              {club.contactEmail}
            </a>
          </li>
          <li class="pt-3 border-t border-surface-border/60">
            <a href="/impressum" class="hover:text-primary transition-colors font-medium focus-visible:ring-1 focus-visible:ring-primary rounded">Impressum</a>
          </li>
          <li>
            <a href="/datenschutz" class="hover:text-primary transition-colors font-medium focus-visible:ring-1 focus-visible:ring-primary rounded">Datenschutzerklärung</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-surface-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <p>© {currentYear} {club.name}. Alle Rechte vorbehalten.</p>
      <p class="text-gray-300">Keine Cookies, kein Tracking. 100% Ruhrgebiet.</p>
    </div>

  </div>
</footer>
