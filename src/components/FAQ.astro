---
interface FAQItem {
  question: string;
  paragraphs: string[];
  bullets?: string[];
  closingParagraph?: string;
}

const faqs: FAQItem[] = [
  {
    question: "Kann ich einfach unverbindlich mitfahren oder muss ich direkt Mitglied werden?",
    paragraphs: [
      "Du bist jederzeit herzlich willkommen! Fahr einfach 2–3 Runden ganz unverbindlich mit, lerne die Truppe kennen und spüre, ob der Vibe zu dir passt.",
      "Erst wenn du merkst, dass du bleiben willst, füllst du entspannt den Mitgliedsantrag aus – vorher gibt es keinerlei Verpflichtung."
    ]
  },
  {
    question: "Ich bin noch nie in der Gruppe gefahren (Windschatten, Handzeichen) – lernt man das bei euch?",
    paragraphs: [
      "Keine Sorge, niemand wird als Peloton-Profi geboren. Sag uns am Treffpunkt einfach kurz Bescheid: Wir erklären dir vor dem Start entspannt die wichtigsten Handzeichen und Windschattenregeln.",
      "Auf der Strecke nehmen wir dich in die Mitte, fahren vorausschauend und achten aufeinander – nach 20 Kilometern fühlt sich das völlig vertraut an."
    ]
  },
  {
    question: "Wie schnell und weit fahrt ihr? Was passiert, wenn ich am Berg nicht mitkomme?",
    paragraphs: [
      "Bei uns gilt das strikte <strong>No-Drop-Prinzip</strong>: Nach Anstiegen oder Ampelphasen wird immer gewartet. Niemand wird zurückgelassen."
    ],
    bullets: [
      "<strong>Rennrad (Asphalt):</strong> Ca. 26–29 km/h Schnitt im Grundlagenbereich.",
      "<strong>Gravel & Trassen:</strong> Ca. 22–25 km/h Schnitt auf wechselndem Untergrund."
    ],
    closingParagraph: "Streckendaten (Länge, Höhenmeter, Tempo) siehst du immer transparent vorab auf Joinride."
  },
  {
    question: "Welches Fahrrad und Equipment brauche ich?",
    paragraphs: [
      "Ob Carbon, Alu oder Stahl – Hauptsache zwei Räder und technisch verkehrssicher (verlässliche Bremsen, saubere Kette, gute Reifen)."
    ],
    bullets: [
      "<strong>Helmpflicht:</strong> Ohne passenden Helm rollt bei uns kein Rad los.",
      "<strong>Pannenset:</strong> Ersatzschlauch/Plugs, Reifenheber und Minipumpe gehören ins Gepäck.",
      "<strong>Verpflegung:</strong> Trinkflaschen und ein Snack gegen den Hungerast."
    ],
    closingParagraph: "Bei Pannen hält die gesamte Gruppe an und hilft gemeinsam."
  },
  {
    question: "Dürfen auch Frauen / FLINTA* mitfahren und wie ist die Stimmung?",
    paragraphs: [
      "Ein klares <strong>Ja, unbedingt!</strong> Bei uns gibt es kein Macho-Gehabe, keine ungefragten Watt-Belehrungen und kein Gehabe an der Ampel.",
      "Wir begegnen uns auf Augenhöhe – vollkommen unabhängig von Geschlecht, Material oder Trainingsstand. Uns verbinden Spaß, Respekt und ehrlicher Pott-Humor."
    ]
  },
  {
    question: "Was kostet eine Mitgliedschaft und gibt es Vereinsverpflichtungen?",
    paragraphs: [
      "Bei uns gibt es <strong>0 % Vereinsmeierei</strong>: Es gibt weder Pflicht-Arbeitsstunden noch verpflichtende Versammlungen – wir wollen einfach gemeinsam Rad fahren.",
      "Der Mitgliedsbeitrag ist bewusst fair und schlank kalkuliert, um Verbandsabgaben und deinen BDR-Versicherungsschutz abzudecken. Die genauen Zahlen findest du transparent im Mitgliedsantrag-PDF."
    ]
  },
  {
    question: "Wo starten eure Ausfahrten meistens und woher bekomme ich die Route?",
    paragraphs: [
      "Typische Treffpunkte sind z. B. die <em>Schwimmhalle Gelsenkirchen-Horst</em> (Nordsternpark), das Welterbe <em>Zeche Zollverein</em> (Essen) oder Trassen-Kreuze an der <em>Erzbahntrasse</em>.",
      "Alle Termine inklusive Startort und <strong>herunterladbarem GPX-Track</strong> findest du vorab auf <strong>Joinride</strong>. Spontane Feierabendrunden kündigen wir via Instagram (<strong>@dynamoruhr</strong>) an."
    ]
  }
];
---

<section id="faq" class="py-20 lg:py-28 bg-surface-dark border-b border-surface-border relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-bold uppercase tracking-wider mb-3">
        Häufige Fragen
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display">
        Fragen vor dem ersten Tritt?
      </h2>
      <p class="text-gray-400 mt-3 text-base sm:text-lg">
        Alles, was du über unsere Ausfahrten, das Mitfahren und den Verein wissen musst – ehrlich, ausführlich und ohne Fachchinesisch.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details 
          class="group bg-surface-card border border-surface-border rounded-2xl transition-all duration-300 hover:border-primary/40 open:border-primary/60 open:shadow-lg overflow-hidden"
        >
          <summary 
            class="flex items-center justify-between p-6 cursor-pointer list-none select-none text-white font-display font-bold text-lg sm:text-xl transition-colors group-hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-2xl"
          >
            <span class="pr-6 leading-snug">{faq.question}</span>
            <span class="shrink-0 w-8 h-8 rounded-full bg-surface-dark border border-surface-border flex items-center justify-center text-primary group-open:rotate-180 transition-transform duration-300" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 pt-2 text-gray-300 text-sm sm:text-base leading-relaxed border-t border-surface-border/40 font-sans space-y-3">
            {faq.paragraphs.map(paragraph => (
              <p set:html={paragraph} />
            ))}

            {faq.bullets && faq.bullets.length > 0 && (
              <ul class="space-y-2.5 my-3 pl-0.5">
                {faq.bullets.map(bullet => (
                  <li class="flex items-start gap-3 text-gray-300">
                    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary/10 border border-primary/30 text-primary shrink-0 mt-0.5 text-xs font-bold" aria-hidden="true">
                      ✓
                    </span>
                    <span set:html={bullet} class="leading-relaxed"></span>
                  </li>
                ))}
              </ul>
            )}

            {faq.closingParagraph && (
              <p class="leading-relaxed pt-1" set:html={faq.closingParagraph} />
            )}
          </div>
        </details>
      ))}
    </div>

    <!-- Bottom Reassurance / Direct Contact CTA -->
    <div class="mt-12 text-center p-6 rounded-2xl bg-surface-card/60 border border-surface-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-left">
        <h3 class="text-base font-bold text-white mb-1">Deine Frage war nicht dabei?</h3>
        <p class="text-xs sm:text-sm text-gray-400">Schreib uns einfach kurz – wir antworten schnell, hilfsbereit und unkompliziert.</p>
      </div>
      <a 
        href="#kontakt" 
        class="min-h-[44px] inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs sm:text-sm font-bold tracking-wide transition-all shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-white shrink-0"
      >
        <span>Frage stellen</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>

  </div>
</section>
