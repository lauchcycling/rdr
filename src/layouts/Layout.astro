---
import '@fontsource-variable/inter';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "RC Dynamo Ruhr e.V. – Radsport & Grouprides im Ruhrgebiet",
  description = "Radsportverein im Ruhrgebiet: Gemeinsame Rennrad- & Gravel-Grouprides in Essen, Gelsenkirchen & Umgebung. Kette rechts, lockere Typen, keine Vereinsmeierei!",
  ogImage = "/images/og-image.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://dynamoruhr.de");
---

<!doctype html>
<html lang="de" class="scroll-smooth bg-surface-dark text-[#EDEDED] antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social Media (Fallback-Struktur) -->
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RC Dynamo Ruhr e.V." />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RC Dynamo Ruhr e.V. – Radsport im Ruhrgebiet" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Lokales SEO & Knowledge Graph: Strukturierte Daten (Schema.org SportsClub & WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["SportsClub", "SportsOrganization"],
          "@id": "https://dynamoruhr.de/#organization",
          "name": "RC Dynamo Ruhr e.V.",
          "legalName": "RC Dynamo Ruhr e.V.",
          "alternateName": ["Dynamo Ruhr", "Radsportclub Dynamo Ruhr"],
          "url": "https://dynamoruhr.de",
          "logo": {
            "@type": "ImageObject",
            "@id": "https://dynamoruhr.de/#logo",
            "url": "https://dynamoruhr.de/images/logo.png",
            "caption": "RC Dynamo Ruhr e.V. Logo"
          },
          "image": "https://dynamoruhr.de/images/og-image.jpg",
          "description": "Radsportverein für Rennrad, Gravel und Grouprides im Ruhrgebiet (Essen, Gelsenkirchen, Recklinghausen und Umgebung).",
          "sport": ["Radsport", "Rennrad", "Gravel", "Cyclocross"],
          "email": "club@dynamoruhr.de",
          "foundingDate": "2021-08-15",
          "identifier": "VR 6170 (Amtsgericht Essen)",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Essen",
            "addressRegion": "Nordrhein-Westfalen",
            "addressCountry": "DE"
          },
          "memberOf": [
            {
              "@type": "SportsOrganization",
              "name": "Bund Deutscher Radfahrer e.V. (BDR)",
              "url": "https://www.rad-net.de"
            },
            {
              "@type": "SportsOrganization",
              "name": "Radsportverband NRW e.V.",
              "url": "https://www.radsportverband-nrw.de"
            }
          ],
          "sameAs": [
            "https://instagram.com/dynamoruhr",
            "https://strava.com/clubs/dynamoruhr"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://dynamoruhr.de/#website",
          "url": "https://dynamoruhr.de",
          "name": "RC Dynamo Ruhr e.V.",
          "description": "Radsportverein für Rennrad & Gravel im Ruhrgebiet",
          "publisher": {
            "@id": "https://dynamoruhr.de/#organization"
          },
          "inLanguage": "de-DE"
        }
      ]
    })} />

    <!-- Accessibility Styles: High-Contrast Focus Visible & Reduced Motion Support -->
    <style is:global>
      :focus-visible {
        outline: 2px solid #E94F1B !important;
        outline-offset: 3px !important;
      }
      
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
    <!-- 100% DSGVO-konform: 0 Tracking, 0 Cookies, 0 externe CDNs -->
  </head>
  <body class="flex min-h-screen flex-col font-sans selection:bg-primary selection:text-white">
    <!-- A11y Skip to Main Content Link (WCAG 2.4.1) -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-5 focus:py-3.5 focus:bg-primary focus:text-white focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-4 focus:ring-white transition-all text-sm uppercase tracking-wider"
    >
      Direkt zum Hauptinhalt springen
    </a>
    <slot />
  </body>
</html>
