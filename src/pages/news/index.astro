---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const newsEntries = await getCollection('news');
const sortedNews = newsEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout 
  title="Club-News, Berichte & Ausfahrten | RC Dynamo Ruhr e.V."
  description="Aktuelle Berichte, Ausfahrten und Vereinsgeschichten vom RC Dynamo Ruhr e.V. – Rennrad und Gravel im Ruhrgebiet zwischen Essen, Gelsenkirchen und Recklinghausen."
>
  <Header />
  <main class="flex-grow">
    <div class="py-16 sm:py-24 bg-surface-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="mb-14">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-400 hover:text-primary transition-colors mb-6 uppercase tracking-wider">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Zurück zur Startseite</span>
        </a>
        <h1 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display mb-4">
          Club-<span class="text-primary">News</span> & Berichte
        </h1>
        <p class="text-base sm:text-lg text-gray-400 max-w-2xl leading-relaxed">
          Von epischen Ausfahrten über Vereinsmeierei-freie Clubabende bis hin zu harten Trainingsdaten: Hier gibt’s die ungefilterte Wahrheit vom Asphalt.
        </p>
      </div>

      <!-- Articles Feed -->
      <div class="space-y-8">
        {sortedNews.map((article) => (
          <article class="bg-surface-card border border-surface-border rounded-3xl p-6 sm:p-10 transition-all duration-300 hover:border-primary/50 hover:shadow-glow">
            <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400 mb-4">
              <time datetime={article.data.date.toISOString()} class="font-mono text-gray-300">
                {new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(article.data.date)}
              </time>
              <span>•</span>
              <span class="text-primary font-medium">{article.data.author}</span>
              {article.data.tags && article.data.tags.map((tag: string) => (
                <span class="px-2.5 py-0.5 rounded-full bg-surface-dark border border-surface-border text-gray-400 text-[11px]">
                  #{tag}
                </span>
              ))}
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4 font-display hover:text-primary transition-colors">
              <a href={`/news/${article.slug}`}>
                {article.data.title}
              </a>
            </h2>

            <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-6">
              {article.data.description}
            </p>

            <div class="pt-4 border-t border-surface-border/60 flex items-center justify-between">
              <a 
                href={`/news/${article.slug}`} 
                class="inline-flex items-center gap-2 text-primary hover:text-primary-hover font-bold text-sm uppercase tracking-wider"
              >
                <span>Ganzen Bericht lesen</span>
                <span>→</span>
              </a>
              <span class="text-xs text-gray-500 font-mono">
                RC Dynamo Ruhr
              </span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
  </main>
  <Footer />
</Layout>
