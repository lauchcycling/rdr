---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = new Intl.DateTimeFormat('de-DE', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(entry.data.date);
---

<Layout 
  title={`${entry.data.title} | RC Dynamo Ruhr e.V.`}
  description={entry.data.description}
  ogImage={entry.data.image || '/images/og-image.jpg'}
>
  <Header />
  <main id="main-content" class="flex-grow">
    <article class="py-16 sm:py-24 bg-surface-dark min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Navigation -->
      <div class="mb-10">
        <a 
          href="/news" 
          class="inline-flex items-center gap-2 text-xs font-semibold text-gray-400 hover:text-primary transition-colors uppercase tracking-wider"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Zurück zur Übersicht</span>
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-12 pb-8 border-b border-surface-border">
        <!-- Tags & Date -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400 mb-6">
          <time datetime={entry.data.date.toISOString()} class="font-mono text-gray-300">
            {formattedDate}
          </time>
          <span>•</span>
          <span class="text-primary font-medium">{entry.data.author}</span>
          {entry.data.tags && entry.data.tags.map((tag: string) => (
            <span class="px-2.5 py-0.5 rounded-full bg-surface-card border border-surface-border text-gray-300 text-[11px]">
              #{tag}
            </span>
          ))}
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight leading-tight mb-6">
          {entry.data.title}
        </h1>

        <!-- Lead / Description -->
        <p class="text-lg sm:text-xl text-gray-300 leading-relaxed font-medium italic border-l-4 border-primary pl-4 py-1">
          {entry.data.description}
        </p>
      </header>

      <!-- Markdown Article Content -->
      <div class="article-content text-gray-300 text-base sm:text-lg leading-relaxed space-y-6">
        <Content />
      </div>

      <!-- Article Footer / Share & Back -->
      <footer class="mt-16 pt-8 border-t border-surface-border flex flex-col sm:flex-row items-center justify-between gap-4">
        <a 
          href="/news" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-surface-card border border-surface-border hover:border-primary text-white text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span aria-hidden="true">←</span>
          <span>Zurück zu allen News</span>
        </a>
        <a 
          href="/#groupride" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary hover:bg-primary-hover text-white text-sm font-bold transition-all shadow-glow focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span>Zum nächsten Groupride</span>
          <span aria-hidden="true">→</span>
        </a>
      </footer>

    </div>
  </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Rich prose styling for rendered markdown articles */
  .article-content h2 {
    font-size: 1.875rem;
    font-weight: 800;
    color: #ffffff;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    border-bottom: 1px solid #2A2A2A;
    padding-bottom: 0.5rem;
  }
  
  .article-content h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #EDEDED;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-content p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .article-content strong {
    color: #ffffff;
    font-weight: 700;
  }

  .article-content ul, .article-content ol {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content ul {
    list-style-type: disc;
  }

  .article-content ol {
    list-style-type: decimal;
  }

  .article-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .article-content blockquote {
    border-left: 4px solid #E94F1B;
    background-color: #1A1A1A;
    padding: 1.25rem 1.5rem;
    border-radius: 0 1rem 1rem 0;
    margin: 2rem 0;
    font-style: italic;
    color: #EDEDED;
    font-size: 1.15rem;
  }

  .article-content img {
    border-radius: 1rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
    width: 100%;
    height: auto;
    border: 1px solid #2A2A2A;
  }

  .article-content a {
    color: #E94F1B;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  .article-content a:hover {
    color: #FF6B35;
  }

  .article-content a:focus-visible {
    outline: 2px solid #E94F1B;
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
